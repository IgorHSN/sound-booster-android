<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <!-- App label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="LOUDIFY"
        android:textSize="11sp"
        android:letterSpacing="0.3"
        android:textColor="@color/text_label"
        android:fontFamily="sans-serif-light" />

    <!-- Big dB number -->
    <TextView
        android:id="@+id/tvBoostDb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="+0"
        android:textSize="96sp"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-thin"
        android:letterSpacing="-0.05"
        android:lineSpacingExtra="0dp" />

    <!-- "dB" unit -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="dB"
        android:textSize="18sp"
        android:letterSpacing="0.15"
        android:textColor="@color/text_secondary"
        android:fontFamily="sans-serif-light"
        android:layout_marginTop="-8dp" />

    <!-- Slider -->
    <SeekBar
        android:id="@+id/sbBoost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/text_primary"
        android:progressBackgroundTint="@color/slider_track"
        android:thumbTint="@color/text_primary" />

    <!-- Slider range labels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 dB"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvBoostPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+60 dB"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:gravity="end" />

    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="● inativo"
        android:textSize="11sp"
        android:letterSpacing="0.15"
        android:textColor="@color/status_inactive" />

    <!-- Toggle button -->
    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="72dp"
        android:text="ATIVAR"
        android:textSize="13sp"
        android:letterSpacing="0.2"
        android:textColor="@color/text_primary"
        android:backgroundTint="@color/background"
        style="@style/Widget.Material3.Button.OutlinedButton" />

    <!-- Ad banner placeholder (60dp) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="60dp" />

</LinearLayout>
